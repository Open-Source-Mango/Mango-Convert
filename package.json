{
  "name": "mango-convert",
  "version": "1.0.0",
  "description": "Mango Convert",
  "author": "Mango",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -wl"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.mango.convert",
    "productName": "Mango Convert",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "AudioVideo",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "ffmpeg-static@5.3.0": true,
    "sharp@0.33.5": true
  }
}
